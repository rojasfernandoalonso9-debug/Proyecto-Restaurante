# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/restaurant_management?serverTimezone=UTC
DB_USERNAME=restaurant_app
DB_PASSWORD=replace_with_a_local_password

# JWT secret (replace with a securely generated value of at least 256 bits)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=3600000

# Frontend API base URL
VITE_API_URL=http://localhost:8080/api
